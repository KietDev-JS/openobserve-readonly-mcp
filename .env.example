# Copy to .env for local development, or set these in your MCP client's env block.
# Never commit a filled-in copy.

# Required: your OpenObserve instance. A reverse-proxy subpath is supported.
O2_BASE_URL=https://openobserve.example.com

# Required: "Basic <base64 of email:password>" or "Bearer <token>".
# Use a read-only OpenObserve user.
O2_AUTH=Basic BASE64_OF_EMAIL_COLON_PASSWORD

# Optional.
O2_ORG=default
O2_MAX_WINDOW_MIN=1440
O2_TIMEOUT_MS=60000
